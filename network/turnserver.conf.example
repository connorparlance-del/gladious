# Ejemplo de configuración de coturn (servidor TURN propio) — opcional.
# Instala coturn en un VPS con IP pública y abre los puertos indicados.
listening-port=3478
tls-listening-port=5349
# IP pública del servidor:
external-ip=203.0.113.10
realm=turn.midominio.com
fingerprint
lt-cred-mech
# Usuario estático (sencillo). Para producción es mejor usar use-auth-secret
# con credenciales temporales generadas por un backend.
user=gladiadores:CAMBIA_ESTA_CLAVE
# Certificados para turns:// (Let's Encrypt)
cert=/etc/letsencrypt/live/turn.midominio.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.midominio.com/privkey.pem
min-port=49152
max-port=65535
no-cli
